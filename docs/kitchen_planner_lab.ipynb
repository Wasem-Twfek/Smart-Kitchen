   "source": [
    "# Smart Kitchen Meal Planner Lab\n",
    "\n",
    "## 1. Описание системы\n",
    "\n",
    "Smart Kitchen Meal Planner - это умная система планирования приготовления пищи, которая помогает:\n",
    "- Управлять инвентарем продуктов в холодильнике\n",
    "- Рекомендовать рецепты на основе доступных ингредиентов\n",
    "- Автоматически создавать список покупок\n",
    "- Оптимизировать использование продуктов\n",
    "\n",
    "## 2. Основные компоненты\n",
    "\n",
    "1. **Управление инвентарем**\n",
    "   - Добавление/удаление продуктов\n",
    "   - Отслеживание сроков годности\n",
    "   - Автоматическое объединение одинаковых продуктов\n",
    "\n",
    "2. **Система рекомендаций**\n",
    "   - Поиск рецептов по доступным ингредиентам\n",
    "   - Проверка наличия необходимой утвари\n",
    "   - Масштабирование порций\n",
    "   - Оценка совместимости ингредиентов\n",
    "\n",
    "3. **Список покупок**\n",
    "   - Автоматическое создание списка\n",
    "   - Планирование покупок\n",
    "   - Интеграция с системой заказов\n",
    "\n",
    "## 3. Практическая часть\n",
    "\n",
    "### 3.1. Управление инвентарем"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "from dataclasses import dataclass\n",
    "from typing import List, Dict, Optional\n",
    "from datetime import datetime\n",
    "from collections import defaultdict\n",
    "\n",
    "@dataclass\n",
    "class Ingredient:\n",
    "    \"\"\"Класс для представления ингредиента\"\"\"\n",
    "    name: str\n",
    "    quantity: float\n",
    "    unit: str\n",
    "    perishable: bool\n",
    "    expiry_date: Optional[str]\n",
    "    category: str\n",
    "\n",
    "@dataclass\n",
    "class Fridge:\n",
    "    \"\"\"Класс для управления холодильником\"\"\"\n",
    "    fridge_id: str\n",
    "    owner: str\n",
    "    items: List[Ingredient]\n",
    "    capacity: int\n",
    "    temperature: float\n",
    "\n",
    "    def add_item(self, item: Ingredient) -> None:\n",
    "        \"\"\"Добавление ингредиента в холодильник\"\"\"\n",
    "        # Проверка наличия продукта\n",
    "        existing = next((i for i in self.items if i.name == item.name), None)\n",
    "        if existing:\n",
    "            # Объединение одинаковых продуктов\n",
    "            if existing.unit == item.unit:\n",
    "                existing.quantity += item.quantity\n",
    "            else:\n",
    "                # Конвертация единиц измерения\n                converted = self.convert_units(item.quantity, item.unit, existing.unit)\n",
    "                existing.quantity += converted\n",
    "        else:\n",
    "            # Добавление нового продукта\n",
    "            self.items.append(item)\n",
    "\n",
    "    def check_expiry(self) -> List[str]:\n",
    "        \"\"\"Проверка сроков годности продуктов\"\"\"\n",
    "        today = datetime.now().date()\n",
    "        expired = []\n",
    "        for item in self.items:\n",
    "            if item.expiry_date:\n",
    "                expiry = datetime.strptime(item.expiry_date, '%Y-%m-%d').date()\n",
    "                if expiry < today:\n",
    "                    expired.append(item.name)\n",
    "        return expired\n",
    "\n",
    "    def optimize_storage(self) -> None:\n",
    "        \"\"\"Оптимизация хранения продуктов\"\"\"\n",
    "        # Сортировка по категориям\n",
    "        sorted_items = sorted(self.items, key=lambda x: x.category)\n",
    "        # Группировка\n",
    "        grouped = defaultdict(list)\n",
    "        for item in sorted_items:\n",
    "            grouped[item.category].append(item)\n",
    "        # Обновление списка\n",
    "        self.items = [item for group in grouped.values() for item in group]\n",
    "\n",
    "    @staticmethod\n",
    "    def convert_units(value: float, from_unit: str, to_unit: str) -> float:\n",
    "        \"\"\"Конвертация единиц измерения\"\"\"\n",
    "        # Пример конвертации для массы\n",
    "        if from_unit == 'г' and to_unit == 'кг':\n",
    "            return value / 1000\n",
    "        elif from_unit == 'кг' and to_unit == 'г':\n",
    "            return value * 1000\n",
    "        # По умолчанию возвращаем исходное значение\n",
    "        return value"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.2. Пример использования"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Создаем холодильник\n",
    "my_fridge = Fridge(\n",
    "    fridge_id='fridge_1',\n",
    "    owner='student',\n",
    "    items=[],\n",
    "    capacity=10000,  # максимальная вместимость в граммах\n",
    "    temperature=4.0  # температура в градусах Цельсия\n",
    ")\n",
    "\n",
    "# Добавляем продукты\n",
    "my_fridge.add_item(Ingredient(\n",
    "    name='яйца',\n",
    "    quantity=6,\n",
    "    unit='шт',\n",
    "    perishable=True,\n",
    "    expiry_date='2025-06-15',\n",
    "    category='яйца'\n",
    "))\n",
    "\n",
    "my_fridge.add_item(Ingredient(\n",
    "    name='молоко',\n",
    "    quantity=500,\n",
    "    unit='мл',\n",
    "    perishable=True,\n",
    "    expiry_date='2025-06-10',\n",
    "    category='молоко'\n",
    "))\n",
    "\n",
    "# Проверяем сроки годности\n",
    "expired = my_fridge.check_expiry()\n",
    "print(f'Истекшие сроки годности: {expired}')\n",
    "\n",
    "# Оптимизируем хранение\n",
    "my_fridge.optimize_storage()\n",
    "print('\nОптимизированный список продуктов:')\n",
    "for item in my_fridge.items:\n",
    "    print(f'{item.name}: {item.quantity} {item.unit}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.3. Упражнения\n",
    "\n",
    "1. Добавьте в холодильник новые продукты:\n",
    "   - 1 кг муки\n",
    "   - 200 г сахара\n",
    "   - 100 г сливочного масла\n",
    "\n",
    "2. Попробуйте добавить продукт, который превышает вместимость холодильника. Что произойдет?\n",
    "\n",
    "3. Измените срок годности одного из продуктов и проверьте работу функции check_expiry()\n",
    "\n",
    "4. Добавьте новый метод для расчета общей массы продуктов в холодильнике"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Решение упражнения 4\n",
    "def calculate_total_weight(self) -> float:\n",
    "    \"\"\"Расчет общей массы продуктов\"\"\"\n",
    "    total = 0\n",
    "    for item in self.items:\n",
    "        # Конвертируем все в граммы\n",
    "        if item.unit == 'кг':\n",
    "            total += item.quantity * 1000\n",
    "        else:\n",
    "            total += item.quantity\n",
    "    return total\n",
    "\n",
    "# Добавляем метод в класс Fridge\n",
    "Fridge.calculate_total_weight = calculate_total_weight\n",
    "\n",
    "# Проверяем работу\n",
    "print(f'Общая масса продуктов: {my_fridge.calculate_total_weight()} г')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Система рекомендаций рецептов\n",
    "\n",
    "### 4.1. Описание алгоритма\n",
    "\n",
    "Алгоритм рекомендаций учитывает:\n",
    "1. Доступность ингредиентов\n",
    "2. Наличие необходимой утвари\n",
    "3. Совместимость ингредиентов\n",
    "4. Сроки годности продуктов\n",
    "5. Категории продуктов\n",
    "\n",
    "### 4.2. Реализация"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "@dataclass\n",
    "class Recipe:\n",
    "    \"\"\"Класс для представления рецепта\"\"\"\n",
    "    name: str\n",
    "    ingredients: List[Ingredient]\n",
    "    utensils: List[str]\n",
    "    servings: int\n",
    "    category: str\n",
    "    tags: List[str]\n",
    "\n",
    "    def calculate_compatibility(self, fridge: Fridge) -> float:\n",
    "        \"\"\"Расчет совместимости рецепта с ингредиентами в холодильнике\"\"\"\n",
    "        score = 0\n",
    "        \n",
    "        # Оценка наличия ингредиентов\n",
    "        ingredient_score = sum(1 for i in self.ingredients \n",
    "                             if any(f.name == i.name and f.quantity >= i.quantity \n",
    "                                   for f in fridge.items)) / len(self.ingredients)\n",
    "        \n",
    "        # Оценка категорий продуктов\n",
    "        categories = set(i.category for i in self.ingredients)\n",
    "        category_score = len(categories & set(f.category for f in fridge.items)) / len(categories)\n",
    "        \n",
    "        # Оценка сроков годности\n",
    "        expiry_score = 1.0  # Если все продукты свежие\n",
    "        for ingredient in self.ingredients:\n",
    "            matching = [f for f in fridge.items if f.name == ingredient.name]\n",
    "            if matching and any(f.expiry_date and \n",
    "                              datetime.strptime(f.expiry_date, '%Y-%m-%d').date() < datetime.now().date() \n",
    "                              for f in matching):\n",
    "                expiry_score = 0.5  # Уменьшаем оценку если есть просроченные продукты\n",
    "        \n",
    "        # Итоговая оценка\n",
    "        score = 0.5 * ingredient_score + 0.3 * category_score + 0.2 * expiry_score\n",
    "        return score\n",
    "\n",
    "    def scale(self, new_servings: int) -> None:\n",
    "        \"\"\"Масштабирование рецепта для нового количества порций\"\"\"\n",
    "        ratio = new_servings / self.servings\n",
    "        for ingredient in self.ingredients:\n",
    "            ingredient.quantity *= ratio\n",
    "        self.servings = new_servings"
   ]
  },
  {
   "cell_type": "markdown",
