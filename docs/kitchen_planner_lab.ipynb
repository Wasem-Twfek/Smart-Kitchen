   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4.4. Упражнения\n",
    "\n",
    "1. Создайте новый рецепт 'Блинчики' с ингредиентами:\n",
    "   - 200 г муки\n",
    "   - 300 мл молока\n",
    "   - 2 яйца\n",
    "   - 30 г сахара\n",
    "\n",
    "2. Добавьте в рецепт теги 'завтрак' и 'десерт'\n",
    "\n",
    "3. Масштабируйте рецепт для 4 порций\n",
    "\n",
    "4. Добавьте новый метод для расчета времени приготовления рецепта"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Решение упражнения 4\n",
    "def calculate_cooking_time(self) -> int:\n",
    "    \"\"\"Расчет времени приготовления в минутах\"\"\"\n",
    "    base_time = 10  # базовое время\n",
    "    \n",
    "    # Добавляем время за каждый ингредиент\n",
    "    for ingredient in self.ingredients:\n",
    "        if ingredient.category == 'мясо':\n",
    "            base_time += 5  # мясо требует больше времени\n",
    "        elif ingredient.category == 'овощи':\n",
    "            base_time += 3\n",
    "    \n",
    "    # Учитываем количество порций\n    """Время приготовления увеличивается пропорционально количеству порций\""\"\n",
    "    base_time *= (self.servings / 1)  # нормируем на 1 порцию\n",
    "    \n",
    "    return int(base_time)\n",
    "\n",
    "# Добавляем метод в класс Recipe\n",
    "Recipe.calculate_cooking_time = calculate_cooking_time\n",
    "\n",
    "# Проверяем работу\n",
    "print(f'Время приготовления омлета: {omelette.calculate_cooking_time()} минут')"
   ]
