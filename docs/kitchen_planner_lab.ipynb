   "source": [
    "### 4.3. Пример использования"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Создаем рецепт\n",
    "omelette = Recipe(\n",
    "    name='Омлет',\n",
    "    ingredients=[\n",
    "        Ingredient('яйца', 2, 'шт', True, None, 'яйца'),\n",
    "        Ingredient('молоко', 50, 'мл', True, None, 'молоко'),\n",
    "        Ingredient('сыр', 50, 'г', True, None, 'сыр')\n",
    "    ],\n",
    "    utensils=['сковорода', 'миска', 'вилка'],\n",
    "    servings=1,\n",
    "    category='завтрак',\n",
    "    tags=['быстро', 'вегетарианское']\n",
    ")\n",
    "\n",
    "# Проверяем совместимость с холодильником\n",
    "compatibility = omelette.calculate_compatibility(my_fridge)\n",
    "print(f'Совместимость рецепта: {compatibility:.2f}')\n",
    "\n",
    "# Масштабируем рецепт для 2 порций\n",
    "omelette.scale(2)\n",
    "print('\nИнгредиенты для 2 порций:')\n",
    "for ingredient in omelette.ingredients:\n",
    "    print(f'{ingredient.name}: {ingredient.quantity} {ingredient.unit}')"
   ]
  },
